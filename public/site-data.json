      "calculations": [
        {
          "id": "tractive_resistance_70kmh",
          "section": "drivetrain",
          "label": "Total Road Resistance Force (at 70 km/h)",
          "symbol": "F_{\\text{res}}",
          "equation_tex": "F_{\\text{res}} = f m g + \\frac{1}{2}\\rho C_d A v^2 = 44.15\\text{ N} + 137.91\\text{ N}",
          "inputs": [
            {
              "symbol": "m",
              "value": "180",
              "unit": "kg"
            },
            {
              "symbol": "v",
              "value": "19.44",
              "unit": "m/s"
            },
            {
              "symbol": "C_d \\cdot A",
              "value": "0.595",
              "unit": "m\u00b2"
            }
          ],
          "result": "182.1",
          "unit": "N (Power Demand: 3.54 kW)",
          "status": "recalculated"
        },
        {
          "id": "sprocket_ratio",
          "section": "drivetrain",
          "label": "Sprocket Reduction Ratio",
          "symbol": "i",
          "equation_tex": "i = \\frac{N_{\\text{driven}}}{N_{\\text{drive}}} = \\frac{42}{15}",
          "inputs": [
            {
              "symbol": "N_{\\text{driven}}",
              "value": "42",
              "unit": "teeth"
            },
            {
              "symbol": "N_{\\text{drive}}",
              "value": "15",
              "unit": "teeth"
            }
          ],
          "result": "2.80",
          "unit": "\u2014",
          "status": "recalculated"
        },
        {
          "id": "drivetrain_axle_torque",
          "section": "drivetrain",
          "label": "Rear Axle Available Tractive Torque",
          "symbol": "T_{\\text{axle}}",
          "equation_tex": "T_{\\text{axle}} = T_{\\text{motor}} \\cdot i \\cdot \\eta_{\\text{chain}} = 78\\text{ N\u00b7m} \\times 2.80 \\times 0.95",
          "inputs": [
            {
              "symbol": "T_{\\text{motor}}",
              "value": "78",
              "unit": "N\u00b7m"
            },
            {
              "symbol": "i",
              "value": "2.80",
              "unit": "\u2014"
            }
          ],
          "result": "207.5",
          "unit": "N\u00b7m (2.11\u00d7 Margin vs Demand)",
          "status": "recalculated"
        },
        {
          "id": "battery_discharge_rate",
          "section": "drivetrain",
          "label": "Battery Continuous C-Rate",
          "symbol": "C_{\\text{cont}}",
          "equation_tex": "C_{\\text{cont}} = \\frac{I_{\\text{rated}}}{C_{\\text{pack}}} = \\frac{70\\text{ A}}{90\\text{ Ah}}",
          "inputs": [
            {
              "symbol": "V_{\\text{nom}}",
