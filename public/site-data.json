    {
      "id": "chassis",
      "title": "Chassis & Frame Structure",
      "subtitle": "Tubular spaceframe architecture and crashworthiness",
      "designTitle": "AISI 4130 Spaceframe Architecture",
      "design": "Fabricated from AISI 4130 Chromoly steel tubes (OD 25.4 mm, 1.65 mm wall thickness; Yield: 460 MPa, UTS: 560 MPa). The chassis links the occupant cell, side impact protection rails, seat anchor points, and rear powertrain cradle into a continuous triangulated loadpath.",
      "approach": "ANSYS 2026 R1 was used to conduct static structural impact analyses (frontal 44.8 kN, lateral 33.6 kN) and torsional stiffness simulations. Direct application of dynamic crash loads in static solvers introduces artificial stress concentrations (26.5 GPa); therefore, nominal member stresses are verified analytically against material yield limits.",
      "calculationIds": [
        "chassis_impact_stress",
        "chassis_torsional_stiffness"
      ],
      "simulations": [
        {
          "name": "Chassis Impact Analysis",
          "analysis": "Static Structural Impact (44.8 kN)",
          "caption": "Front impact: crush zone stress distribution",
          "image": {
            "src": "./figures/sim-chassis-impact.webp",
            "width": 319,
            "height": 152,
            "alt": "Finite-element contour view of the front chassis impact case."
          }
        },
        {
          "name": "Chassis Torsion",
          "analysis": "Static Structural Torsion",
          "caption": "Torsional deflection: displacement contour",
          "image": {
            "src": "./figures/sim-chassis-torsion.webp",
            "width": 695,
            "height": 368,
            "alt": "Finite-element contour view of the chassis torsion case."
          }
        }
      ],
      "wireframe": {
        "src": "./figures/wireframe-chassis.webp",
        "width": 452,
        "height": 394,
        "alt": "CAD line-art diagram of the tubular spaceframe chassis."
      },
      "calculations": [
        {
          "id": "chassis_impact_stress",
          "section": "chassis",
          "label": "Tube Impact Axial Stress",
          "symbol": "\\sigma",
          "equation_tex": "\\sigma = \\frac{F_{\\text{front}}}{2 \\cdot A_{\\text{tube}}} = \\frac{44800}{2 \\times 123.1}",
          "inputs": [
            {
              "symbol": "F_{\\text{front}}",
              "value": "44,800",
              "unit": "N"
            },
            {
              "symbol": "A_{\\text{tube}}",
              "value": "123.1",
              "unit": "mm\u00b2"
            }
          ],
          "result": "181.9",
          "unit": "MPa (FOS: 2.53 vs 460 MPa Yield)",
          "status": "recalculated"
        },
        {
          "id": "chassis_torsional_stiffness",
          "section": "chassis",
          "label": "Torsional Stiffness Estimate",
          "symbol": "K_t",
          "equation_tex": "K_t = \\frac{T}{\\theta} = \\frac{M \\cdot L_{\\text{track}}}{\\arctan(\\Delta z / [W_f / 2])}",
          "inputs": [
            {
              "symbol": "M",
              "value": "500",
              "unit": "N\u00b7m"
            },
            {
              "symbol": "W_f",
              "value": "1032",
              "unit": "mm"
            }
          ],
          "result": "1,240",
          "unit": "N\u00b7m/deg (Target Compliant)",
          "status": "recalculated"
        }
      ],
      "ergonomics": {
        "title": "Occupant Packaging & Posture",
