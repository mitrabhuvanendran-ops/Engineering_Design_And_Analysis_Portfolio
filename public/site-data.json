              "unit": "V"
            },
            {
              "symbol": "Capacity",
              "value": "90",
              "unit": "Ah"
            }
          ],
          "result": "0.78",
          "unit": "C (~55 km Track Range)",
          "status": "recalculated"
        }
      ]
    }
